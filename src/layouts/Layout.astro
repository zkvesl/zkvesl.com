---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'vesl-labs builds tools for verifiable computing: vesl-nockup, open-source primitives for NockApps, and INTEGER, the integrity layer for intelligent machines.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      Type stack: Berkeley Mono if locally installed / self-hosted from /public/fonts/,
      Geist Mono as the public-web fallback. Both have terminal proportions and
      tuned ASCII so Hoon digraphs (`++`, `|%`, `?>`, `=/`) read cleanly.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;500;600;700&display=swap"
    />
    <slot name="head" />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Dark base, warm off-white ink, single neon accent.
       BG matches zkvesl-docs (#0a0a0a). Ink keeps a paper warmth in negative
       so the whole site reads "from the other side of paper," not "stark void." */
    --paper:        #0a0a0a;
    --paper-shade:  #121210;
    --paper-deep:   #1c1b17;
    --paper-alpha:  rgba(10, 10, 10, 0.86);
    --ink:          #e8e2d2;
    --ink-soft:     #cfcaba;
    --muted:        #8a8780;
    --muted-soft:   #5e5b54;
    --rule:         rgba(232, 226, 210, 0.10);
    --rule-strong:  rgba(232, 226, 210, 0.24);
    --faint:        rgba(232, 226, 210, 0.04);

    /* The one accent. Pure neon matches zkvesl-docs exactly. */
    --accent:        #00ffa3;
    --accent-bright: #6dffc8;
    --accent-dim:    #00b572;
    --accent-soft:   rgba(0, 255, 163, 0.12);
    --accent-rule:   rgba(0, 255, 163, 0.32);
    --accent-glow:   rgba(0, 255, 163, 0.18);

    /* Legacy aliases (still referenced by older selectors). */
    --bg: var(--paper);
    --fg: var(--ink);

    --font-mono: 'Berkeley Mono', 'TX-02', 'Geist Mono', 'JetBrains Mono', 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    --font-sans: var(--font-mono);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-mono);
    background: var(--paper);
    color: var(--ink);
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: geometricPrecision;
  }

  body {
    min-height: 100vh;
    position: relative;
    font-feature-settings: "ss01", "ss02", "calt";
  }

  a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: var(--rule-strong);
  }

  a:hover {
    text-decoration-color: var(--accent);
  }

  code, pre {
    font-family: var(--font-mono);
  }

  /* keeps hyphenated names (vesl-nockup, vesl-labs) on one line */
  .nw { white-space: nowrap; }

  ::selection {
    background: var(--accent);
    color: var(--paper);
  }
</style>
