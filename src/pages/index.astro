---
import Layout from '../layouts/Layout.astro';
import CodePanel from '../components/CodePanel.astro';
---

<Layout title="vesl">
  <!-- masthead -->
  <header class="mast">
    <div class="mast-inner">
      <a href="/" class="mast-brand" aria-label="vesl home">
        <span class="mast-rune" aria-hidden="true">|%</span>
        <span class="mast-mark">vesl</span>
      </a>
      <nav class="mast-nav" aria-label="primary">
        <a href="https://docs.zkvesl.org">docs</a>
        <a href="https://github.com/zkVesl/vesl">github</a>
      </nav>
    </div>
    <div class="mast-rule" aria-hidden="true"></div>
  </header>

  <main>
    <!-- hero -->
    <section class="hero">
      <div class="hero-inner">
        <div class="hero-meta" data-reveal>
          <span class="hero-stamp">
            <span class="hero-stamp-rune" aria-hidden="true">@tas</span>
            <span class="hero-stamp-val">vesl</span>
          </span>
          <span class="hero-stamp">
            <span class="hero-stamp-rune" aria-hidden="true">@ud</span>
            <span class="hero-stamp-val">v0.1</span>
          </span>
          <span class="hero-stamp hero-stamp-accent">
            <span class="hero-stamp-rune" aria-hidden="true">@flag</span>
            <span class="hero-stamp-val">in-progress</span>
          </span>
        </div>

        <h1 class="hero-head" data-reveal data-reveal-delay="1">
          <span class="hero-head-line">Primitives and tooling</span>
          <span class="hero-head-line">for <em>verifiable apps.</em></span>
        </h1>

        <p class="hero-sub" data-reveal data-reveal-delay="2">
          ::  Merkle commitments. STARK proofs. RBAC. Audit log. Settlement queue.
          Fourteen verifiable primitives that compose into one deterministic kernel.
          You write the application logic. Vesl writes the crypto.
        </p>

        <div class="hero-cta" data-reveal data-reveal-delay="3">
          <a href="https://docs.zkvesl.org/setup/quickstart" class="btn btn-primary">
            <span>build</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a href="https://docs.zkvesl.org/pitch" class="btn btn-ghost">
            at a glance
          </a>
          <a href="https://docs.zkvesl.org/llms.txt" class="btn btn-quiet" aria-label="for AI agents">
            <span class="btn-rune" aria-hidden="true">::</span>
            for agents
          </a>
        </div>
      </div>
    </section>

    <!-- code panel — the four surfaces -->
    <section class="surfaces" data-reveal>
      <CodePanel />
    </section>

    <!-- thesis row -->
    <section class="thesis">
      <div class="thesis-inner">
        <div class="thesis-block" data-reveal>
          <span class="thesis-rune" aria-hidden="true">?></span>
          <h3>compose, don't write</h3>
          <p>
            ::  Building a verifiable app means weeks of crypto code, replay-attack
            logic, and a hand-rolled HTTP server before you ship a feature. Vesl
            ships those weeks as composable grafts. One command wires any subset
            into your kernel.
          </p>
        </div>

        <div class="thesis-block" data-reveal data-reveal-delay="1">
          <span class="thesis-rune" aria-hidden="true">?></span>
          <h3>typed at every seam</h3>
          <p>
            ::  Every cause has a <code>build_*_poke</code> builder. Every response
            is a <code>PokeOutcome</code>. Drift between Rust and Hoon becomes a
            compile error, not a 3 a.m. page. You write Rust, not noun
            construction.
          </p>
        </div>

        <div class="thesis-block" data-reveal data-reveal-delay="2">
          <span class="thesis-rune" aria-hidden="true">?></span>
          <h3>what you test is what you ship</h3>
          <p>
            ::  <code>vesl-test</code> boots the compiled kernel and runs your
            assertions against it. No mock divergence. No "it works in dev." The
            Nock interpreter your tests hit is the one your users hit.
          </p>
        </div>
      </div>
    </section>

    <!-- catalog -->
    <section class="catalog" id="catalog">
      <div class="catalog-inner">
        <header class="catalog-head" data-reveal>
          <span class="catalog-eyebrow">@tas  ++catalog</span>
          <h2>the library</h2>
          <p class="catalog-lede">
            ::  Four families. Pick what you need. Compose from Rust.
            Nothing is hidden; every graft is one TOML stanza and one source
            commit you can read.
          </p>
        </header>

        <div class="catalog-grid" role="region" aria-label="primitive catalog, scroll horizontally on mobile">
          <article class="cat-group" data-reveal>
            <header class="cat-group-head">
              <span class="cat-rune" aria-hidden="true">++</span>
              <h3>commitment</h3>
              <span class="cat-count">@ud 04</span>
            </header>
            <p class="cat-desc">
              ::  The plumbing of proof. Commit data, verify roots, settle
              notes, prove computations.
            </p>
            <ul class="cat-list">
              <li>
                <code>mint</code>
                <span class="cat-aura">@ux</span>
                <span class="cat-item-desc">append-only merkle commitment</span>
              </li>
              <li>
                <code>settle</code>
                <span class="cat-aura">@ux</span>
                <span class="cat-item-desc">hard settlement, replay protection</span>
              </li>
              <li>
                <code>guard</code>
                <span class="cat-aura">@flag</span>
                <span class="cat-item-desc">soft verification, returns loobean</span>
              </li>
              <li>
                <code>forge</code>
                <span class="cat-aura">@ux</span>
                <span class="cat-item-desc">stark proofs, epoch-versioned</span>
              </li>
            </ul>
          </article>

          <article class="cat-group" data-reveal data-reveal-delay="1">
            <header class="cat-group-head">
              <span class="cat-rune" aria-hidden="true">++</span>
              <h3>gates</h3>
              <span class="cat-count">@ud 05</span>
            </header>
            <p class="cat-desc">
              ::  Pre-written verification predicates. Pick one in the manifest,
              or chain several for multi-step verification.
            </p>
            <ul class="cat-list">
              <li>
                <code>sig-verify-ed25519</code>
                <span class="cat-aura">@flag</span>
                <span class="cat-item-desc">signed attestations</span>
              </li>
              <li>
                <code>sig-verify-schnorr</code>
                <span class="cat-aura">@flag</span>
                <span class="cat-item-desc">nockchain-native signatures</span>
              </li>
              <li>
                <code>manifest-verify</code>
                <span class="cat-aura">@flag</span>
                <span class="cat-item-desc">structured-document commitment</span>
              </li>
              <li>
                <code>set-membership</code>
                <span class="cat-aura">@flag</span>
                <span class="cat-item-desc">allowlist / blocklist</span>
              </li>
              <li>
                <code>bounded-value</code>
                <span class="cat-aura">@flag</span>
                <span class="cat-item-desc">age gates, balance checks</span>
              </li>
            </ul>
          </article>

          <article class="cat-group" data-reveal data-reveal-delay="2">
            <header class="cat-group-head">
              <span class="cat-rune" aria-hidden="true">++</span>
              <h3>state</h3>
              <span class="cat-count">@ud 05</span>
            </header>
            <p class="cat-desc">
              ::  Opinionated state shapes. Registries, queues, counters,
              permissions — domain-keyed scaffolding that slots into your kernel.
            </p>
            <ul class="cat-list">
              <li>
                <code>registry</code>
                <span class="cat-aura">@tas</span>
                <span class="cat-item-desc">user directories, config stores</span>
              </li>
              <li>
                <code>queue</code>
                <span class="cat-aura">@tas</span>
                <span class="cat-item-desc">job queues, request backlogs</span>
              </li>
              <li>
                <code>counter</code>
                <span class="cat-aura">@ud</span>
                <span class="cat-item-desc">sequence numbers, nonces, metering</span>
              </li>
              <li>
                <code>rbac</code>
                <span class="cat-aura">@ux</span>
                <span class="cat-item-desc">permission enforcement</span>
              </li>
              <li>
                <code>kv</code>
                <span class="cat-aura">@tas</span>
                <span class="cat-item-desc">simple key-value store</span>
              </li>
            </ul>
          </article>

          <article class="cat-group" data-reveal data-reveal-delay="3">
            <header class="cat-group-head">
              <span class="cat-rune" aria-hidden="true">++</span>
              <h3>behavior</h3>
              <span class="cat-count">@ud 04</span>
            </header>
            <p class="cat-desc">
              ::  Runtime rules and observers. Input validation, audit logs,
              deterministic time, settlement batching.
            </p>
            <ul class="cat-list">
              <li>
                <code>validate</code>
                <span class="cat-aura">@flag</span>
                <span class="cat-item-desc">rule checks before poke runs</span>
              </li>
              <li>
                <code>log</code>
                <span class="cat-aura">@ud</span>
                <span class="cat-item-desc">monotonic audit trail</span>
              </li>
              <li>
                <code>clock</code>
                <span class="cat-aura">@da</span>
                <span class="cat-item-desc">deterministic time primitive</span>
              </li>
              <li>
                <code>batch</code>
                <span class="cat-aura">@ud</span>
                <span class="cat-item-desc">buffer intents, flush on trigger</span>
              </li>
            </ul>
          </article>
        </div>

        <div class="catalog-scrub" aria-hidden="true">
          <span class="catalog-dot" data-scrub-dot="0"></span>
          <span class="catalog-dot" data-scrub-dot="1"></span>
          <span class="catalog-dot" data-scrub-dot="2"></span>
          <span class="catalog-dot" data-scrub-dot="3"></span>
        </div>
        <p class="catalog-hint" aria-hidden="true">::  swipe →</p>
      </div>
    </section>

    <!-- substrate — love of Nock and Nockchain -->
    <section class="substrate">
      <div class="substrate-inner" data-reveal>
        <span class="substrate-eyebrow">@tas  ++substrate</span>
        <h2>what we stand on.</h2>
        <p class="substrate-body">
          ::  Vesl does not invent the foundation. <strong>Nockchain</strong> ships the
          cryptographic substrate — Schnorr-over-Cheetah, tip5 hashing, transparent
          STARKs, post-quantum by default. Underneath that is <strong>Nock</strong>:
          twelve reduction rules and a single opcode for change.
          Vesl is fourteen primitives on top of all of it.
          <span class="substrate-stress">Your app inherits every layer.</span>
        </p>

        <figure class="substrate-figure" aria-label="Nock 4K — twelve reduction rules">
          <figcaption class="substrate-fig-cap">
            <span class="substrate-fig-rune" aria-hidden="true">::</span>
            <span>Nock 4K. 340 bytes of pseudocode. The smallest deterministic VM that means it.</span>
          </figcaption>
          <pre class="substrate-code" aria-hidden="true" set:html={`<span class="cc">::  nock 4k  —  the whole language</span>

<span class="cs">*</span>[a [b c] d]      [<span class="cs">*</span>[a b c] <span class="cs">*</span>[a d]]

<span class="cs">*</span>[a <span class="cn">0</span> b]          /[b a]
<span class="cs">*</span>[a <span class="cn">1</span> b]          b
<span class="cs">*</span>[a <span class="cn">2</span> b c]        <span class="cs">*</span>[<span class="cs">*</span>[a b] <span class="cs">*</span>[a c]]
<span class="cs">*</span>[a <span class="cn">3</span> b]          ?<span class="cs">*</span>[a b]
<span class="cs">*</span>[a <span class="cn">4</span> b]          +<span class="cs">*</span>[a b]
<span class="cs">*</span>[a <span class="cn">5</span> b c]        =[<span class="cs">*</span>[a b] <span class="cs">*</span>[a c]]

<span class="cs">*</span>[a <span class="cn">6</span> b c d]      <span class="cs">*</span>[a <span class="cs">*</span>[[c d] <span class="cn">0</span> <span class="cs">*</span>[[<span class="cn">2</span> <span class="cn">3</span>] <span class="cn">0</span> <span class="cs">*</span>[a <span class="cn">4</span> <span class="cn">4</span> b]]]]
<span class="cs">*</span>[a <span class="cn">7</span> b c]        <span class="cs">*</span>[<span class="cs">*</span>[a b] c]
<span class="cs">*</span>[a <span class="cn">8</span> b c]        <span class="cs">*</span>[[<span class="cs">*</span>[a b] a] c]
<span class="cs">*</span>[a <span class="cn">9</span> b c]        <span class="cs">*</span>[<span class="cs">*</span>[a c] <span class="cn">2</span> [<span class="cn">0</span> <span class="cn">1</span>] <span class="cn">0</span> b]
<span class="cs">*</span>[a <span class="cn">10</span> [b c] d]   #[b <span class="cs">*</span>[a c] <span class="cs">*</span>[a d]]
<span class="cs">*</span>[a <span class="cn">11</span> [b c] d]   <span class="cs">*</span>[[<span class="cs">*</span>[a c] <span class="cs">*</span>[a d]] <span class="cn">0</span> b]
<span class="cs">*</span>[a <span class="cn">11</span> b c]       <span class="cs">*</span>[a c]`} />
        </figure>

        <ul class="substrate-stack" aria-label="the stack">
          <li>
            <span class="stack-rune" aria-hidden="true">|%</span>
            <span class="stack-name">vesl</span>
            <span class="stack-sep">::</span>
            <span class="stack-desc">14 grafts. typed Rust SDK. real-kernel harness.</span>
          </li>
          <li>
            <span class="stack-rune" aria-hidden="true">|%</span>
            <span class="stack-name">nockchain</span>
            <span class="stack-sep">::</span>
            <span class="stack-desc">PQ crypto. transparent STARKs. schnorr-over-cheetah.</span>
          </li>
          <li>
            <span class="stack-rune" aria-hidden="true">|%</span>
            <span class="stack-name">nock</span>
            <span class="stack-sep">::</span>
            <span class="stack-desc">12 rules. deterministic. forever.</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- status flag -->
    <section class="flag" data-reveal>
      <div class="flag-inner">
        <span class="flag-rune" aria-hidden="true">?></span>
        <p>
          ::  Vesl is in active development. The catalog is stable enough to
          compose; the API surface will move before <span class="flag-stamp">@tas v1.0</span>.
          Build with us if you're shipping something that has to be true, not
          just running.
        </p>
      </div>
    </section>

    <!-- footer -->
    <footer class="foot">
      <div class="foot-inner">
        <div class="foot-brand">
          <span class="foot-rune" aria-hidden="true">|%</span>
          <span class="foot-mark">vesl</span>
          <span class="foot-sep">::</span>
          <span class="foot-attrib">built on nockchain</span>
        </div>
        <nav class="foot-nav" aria-label="footer">
          <a href="https://docs.zkvesl.org">docs</a>
          <a href="https://github.com/zkVesl/vesl">github</a>
          <a href="https://docs.zkvesl.org/llms.txt">llms.txt</a>
        </nav>
      </div>
      <p class="foot-meta" aria-hidden="true">
        @tas  zkvesl.org  ·  @da  ~2026.5.25  ·  @ud  v0.1
      </p>
    </footer>
  </main>
</Layout>

<style>
  /* ─── masthead ─────────────────────────────────────────────── */
  .mast {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper-alpha);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .mast-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mast-brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--font-mono);
  }

  .mast-rune {
    color: var(--accent);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .mast-mark {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.005em;
  }

  .mast-nav {
    display: flex;
    gap: 1.4rem;
    font-family: var(--font-mono);
  }

  .mast-nav a {
    color: var(--muted);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .mast-nav a:hover {
    color: var(--ink);
  }

  .mast-rule {
    height: 1px;
    background: var(--rule);
  }

  /* ─── hero ─────────────────────────────────────────────────── */
  .hero {
    padding: clamp(3.5rem, 8vw, 6.5rem) 1.5rem clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--rule);
  }

  .hero-inner {
    max-width: 880px;
    margin: 0 auto;
  }

  .hero-meta {
    display: flex;
    align-items: stretch;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    margin-bottom: 1.6rem;
  }

  .hero-stamp {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--rule-strong);
    border-radius: 1px;
    font-size: 0.7rem;
    line-height: 1;
    overflow: hidden;
    white-space: nowrap;
  }

  .hero-stamp-rune {
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.32rem 0.5rem;
    border-right: 1px solid var(--accent-rule);
    letter-spacing: 0.04em;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    /* slight luminance to read as marker, not type */
    text-shadow: 0 0 8px var(--accent-glow);
  }

  .hero-stamp-val {
    padding: 0.32rem 0.6rem;
    color: var(--ink);
    letter-spacing: -0.005em;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
  }

  .hero-stamp-accent {
    border-color: var(--accent-rule);
  }

  .hero-stamp-accent .hero-stamp-val {
    color: var(--accent);
  }

  .hero-head {
    font-family: var(--font-mono);
    font-size: clamp(2rem, 6.2vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 1.05;
    color: var(--ink);
    margin-bottom: 1.4rem;
  }

  .hero-head-line {
    display: block;
  }

  .hero-head em {
    font-style: normal;
    color: var(--ink);
    background: linear-gradient(180deg, transparent 62%, var(--accent-soft) 62%, var(--accent-soft) 92%, transparent 92%);
    padding: 0 0.05em;
  }

  .hero-sub {
    font-family: var(--font-mono);
    font-size: clamp(0.92rem, 1.6vw, 1.05rem);
    line-height: 1.75;
    color: var(--ink);
    opacity: 0.82;
    max-width: 640px;
    margin-bottom: 2rem;
  }

  .hero-cta {
    display: flex;
    gap: 0.7rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: 1px;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
    line-height: 1.2;
  }

  .btn:hover { transform: translateY(-1px); text-decoration: none; }

  .btn-primary {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .btn-primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
  }

  .btn-primary .btn-arrow { color: var(--accent); transition: color 0.18s ease; }
  .btn-primary:hover .btn-arrow { color: var(--ink); }

  .btn-ghost {
    background: transparent;
    color: var(--ink);
    border-color: var(--rule-strong);
  }

  .btn-ghost:hover {
    border-color: var(--ink);
    background: var(--paper-shade);
  }

  .btn-quiet {
    background: transparent;
    color: var(--muted);
    padding: 0.7rem 0.8rem;
    border-color: transparent;
  }

  .btn-quiet:hover {
    color: var(--accent);
    background: transparent;
  }

  .btn-quiet .btn-rune { color: var(--accent); }

  /* ─── surfaces (code panel container) ─────────────────────── */
  .surfaces {
    padding: clamp(2rem, 5vw, 3.5rem) 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  /* ─── thesis row ──────────────────────────────────────────── */
  .thesis {
    padding: clamp(2.5rem, 6vw, 4rem) 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .thesis-inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .thesis-block {
    position: relative;
    padding-left: 1.4rem;
  }

  .thesis-rune {
    position: absolute;
    left: 0;
    top: 0.18rem;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1;
  }

  .thesis-block h3 {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--ink);
    margin-bottom: 0.7rem;
    line-height: 1.3;
  }

  .thesis-block p {
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.75;
    color: var(--ink);
    opacity: 0.82;
  }

  .thesis-block code {
    background: var(--accent-soft);
    padding: 1px 4px;
    border-radius: 1px;
    font-size: 0.82rem;
  }

  /* ─── catalog ─────────────────────────────────────────────── */
  .catalog {
    padding: clamp(3rem, 7vw, 5rem) 1.5rem clamp(2rem, 5vw, 3.5rem);
    border-bottom: 1px solid var(--rule);
    background: var(--paper-shade);
  }

  .catalog-inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .catalog-head { margin-bottom: 2.4rem; }

  .catalog-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    letter-spacing: 0.02em;
    display: block;
