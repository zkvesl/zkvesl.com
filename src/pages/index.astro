---
import Layout from '../layouts/Layout.astro';
---

<Layout title="vesl-labs">
  <link slot="head" rel="preload" href="/fonts/plex-mono-500.woff2" as="font" type="font/woff2" crossorigin />

  <main class="labs">
    <!-- intro -->
    <section class="intro">
      <h1 class="intro-mark rise">
        <img src="/vesl-labs.svg" width="497.6" height="248.8" alt="vesl labs" />
      </h1>

      <p class="intro-head rise" data-delay="1">Computation you can check.</p>
      <p class="intro-sub rise" data-delay="2">
        ::  <span class="nw">vesl-labs</span> builds tools for verifiable computing: an <span class="nw">open-source</span> toolkit for
        NockApps, and a gateway whose answers anyone can replay and match.
      </p>
    </section>

    <!-- the two projects -->
    <section class="projects" aria-label="projects">
      <a class="card card-nockup rise" data-delay="3" href="/nockup">
        <header class="card-top">
          <span class="card-num">01</span>
        </header>

        <div class="nockup-mark">
          <span class="nockup-rune" aria-hidden="true">++</span>
          <span class="nockup-name">vesl-nockup</span>
        </div>

        <p class="card-line">
          ::  Primitives and tooling for building verifiable NockApps on Nockchain.
          Compose commitments, proofs and state into one deterministic kernel.
        </p>

        <div class="nockup-stamps" aria-hidden="true">
          <span class="stamp"><span class="stamp-rune">@ud</span><span class="stamp-val">v0.1</span></span>
          <span class="stamp stamp-accent"><span class="stamp-rune">@flag</span><span class="stamp-val">in-progress</span></span>
        </div>

        <footer class="card-go">
          <span>zkvesl.org/nockup</span>
          <span class="card-arrow" aria-hidden="true">→</span>
        </footer>
      </a>

      <a class="card card-integer rise" data-delay="4" href="https://integer.run">
        <header class="card-top">
          <span class="card-num">02</span>
        </header>

        <div class="int-lockup">
          <img src="/integer-wordmark.svg" width="303.6" height="39.1" alt="INTEGER" />
          <span class="int-tagline">The integrity layer for intelligent machines</span>
        </div>

        <p class="int-head">Answers that hold up to audit.</p>

        <p class="int-soon"><span class="int-bar" aria-hidden="true"></span>Coming soon</p>

        <footer class="card-go">
          <span>integer.run</span>
          <span class="card-arrow" aria-hidden="true">↗</span>
        </footer>
      </a>
    </section>

    <!-- footer -->
    <footer class="foot">
      <div class="foot-brand">
        <span class="foot-rune" aria-hidden="true">++</span>
        <span class="foot-mark">vesl-labs</span>
      </div>
      <nav class="foot-nav" aria-label="footer">
        <a href="https://github.com/zkvesl">github</a>
      </nav>
      <p class="foot-meta" aria-hidden="true">@tas  vesl-labs  ·  @da  ~2026.10.24</p>
    </footer>
  </main>
</Layout>

<style>
  @font-face {
    font-family: 'INT Mono';
    src: url('/fonts/plex-mono-500.woff2') format('woff2');
    font-weight: 500;
    font-display: swap;
  }

  .labs {
    /* INTEGER's own palette, used only on its card */
    --int-paper: #efe7da;
    --int-ink:   #221e1b;
    --int-muted: #8a7f74;
    --int-rule:  #d6cbbb;
    --int-spot:  #f67f3a;
    --int-carbon: rgba(63, 61, 64, 0.6);
    --int-font: 'INT Mono', 'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace;

    max-width: 1040px;
    min-height: 100vh;
    margin: 0 auto;
    padding: clamp(3rem, 9vh, 6.5rem) 1.5rem 2.5rem;
    display: flex;
    flex-direction: column;
  }

  /* ─── intro ─────────────────────────────────────────────────── */
  .intro {
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
    text-align: center;
  }

  .intro-mark { margin-bottom: clamp(2rem, 5vh, 3rem); line-height: 0; }

  .intro-mark img {
    width: clamp(200px, 26vw, 260px);
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .intro-head {
    font-size: clamp(1.7rem, 4.6vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.028em;
    line-height: 1.1;
    color: var(--ink);
    margin-bottom: 1.1rem;
  }

  .intro-sub {
    font-size: clamp(0.9rem, 1.5vw, 1rem);
    line-height: 1.75;
    color: var(--ink);
    opacity: 0.82;
    max-width: 620px;
    margin: 0 auto;
  }

  /* ─── project cards ─────────────────────────────────────────── */
  .projects {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: auto;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
    padding: 1.5rem 1.6rem 1.35rem;
    border: 1px solid var(--rule-strong);
    border-radius: 1px;
    text-decoration: none;
    min-height: 330px;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .card:hover { transform: translateY(-2px); text-decoration: none; }
  .card:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card-go {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 0.9rem;
    font-size: 0.84rem;
    letter-spacing: 0.01em;
  }

  .card-arrow { transition: transform 0.18s ease; }
  .card:hover .card-arrow { transform: translateX(3px); }
  .card-integer:hover .card-arrow { transform: translate(2px, -2px); }

  /* vesl-nockup: the vesl side, dark with the green accent */
  .card-nockup {
    background: var(--paper-shade);
    color: var(--ink);
  }

  .card-nockup:hover {
    border-color: var(--accent-rule);
    box-shadow: inset 0 0 60px var(--accent-glow);
  }

  .card-nockup .card-num { color: var(--accent); }
  .card-nockup .card-tag { color: var(--muted); }
  .card-nockup .card-go { border-top: 1px dashed var(--rule); color: var(--ink); }
  .card-nockup .card-arrow { color: var(--accent); }

  .nockup-mark {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .nockup-rune { color: var(--accent); }

  .card-line {
    font-size: 0.86rem;
    line-height: 1.75;
    opacity: 0.82;
    max-width: 30em;
  }

  .nockup-stamps { display: flex; gap: 0.5rem; flex-wrap: wrap; }

  .stamp {
    display: inline-flex;
    border: 1px solid var(--rule-strong);
    border-radius: 1px;
    font-size: 0.68rem;
    line-height: 1;
    white-space: nowrap;
  }

  .stamp-rune {
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.3rem 0.45rem;
    border-right: 1px solid var(--accent-rule);
    letter-spacing: 0.04em;
  }

  .stamp-val { padding: 0.3rem 0.55rem; color: var(--ink); }
  .stamp-accent { border-color: var(--accent-rule); }
  .stamp-accent .stamp-val { color: var(--accent); }

  /* INTEGER: a sheet of integer.run, in its own paper, ink and spot */
  .card-integer {
    background: var(--int-paper);
    color: var(--int-ink);
    border-color: var(--int-paper);
    font-family: var(--int-font);
    font-weight: 500;
  }

  .card-integer:hover { border-color: var(--int-spot); }
  .card-integer .card-num { color: var(--int-spot); }
  .card-integer .card-tag { color: var(--int-muted); }
  .card-integer .card-go { border-top: 1px dashed var(--int-rule); }
  .card-integer .card-arrow { color: var(--int-spot); }

  /* the lockup: the tagline's box spans the wordmark exactly, as on integer.run */
  .int-lockup {
    width: min(100%, 320px);
    container-type: inline-size;
  }

  .int-lockup img { width: 100%; height: auto; display: block; }

  .int-tagline {
    display: block;
    width: calc(100% - 1.2cqi);
    margin-top: 3.6cqi;
    border: 1px solid var(--int-ink);
    box-shadow: 1.2cqi 1.2cqi 0 var(--int-carbon);
    padding: 1.6cqi 0;
    text-align: center;
    text-transform: uppercase;
    font-size: 2.62cqi;
    letter-spacing: 0.1em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .int-head {
    font-size: clamp(1.05rem, 1.9vw, 1.25rem);
    letter-spacing: -0.03em;
    line-height: 1.3;
  }

  .int-soon {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    font-size: 0.9rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }

  .int-bar {
    width: 1.6rem;
    height: 0.4rem;
    background: var(--int-spot);
    flex-shrink: 0;
  }

  /* ─── footer ────────────────────────────────────────────────── */
  .foot {
    margin-top: clamp(3rem, 8vh, 5rem);
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 1fr auto;
    row-gap: 1rem;
    align-items: baseline;
  }

  .foot-brand { display: inline-flex; align-items: baseline; gap: 0.55rem; font-size: 0.86rem; }
  .foot-rune { color: var(--accent); font-weight: 600; font-size: 1rem; }
  .foot-mark { font-weight: 600; }

  .foot-nav a {
    color: var(--muted);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .foot-nav a:hover { color: var(--accent); }

  .foot-meta {
    grid-column: 1 / -1;
    font-size: 0.7rem;
    color: var(--muted);
    opacity: 0.55;
    letter-spacing: 0.02em;
    white-space: pre-wrap;
  }

  /* ─── entrance ──────────────────────────────────────────────── */
  .rise { animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; }
  .rise[data-delay="1"] { animation-delay: 0.08s; }
  .rise[data-delay="2"] { animation-delay: 0.16s; }
  .rise[data-delay="3"] { animation-delay: 0.28s; }
  .rise[data-delay="4"] { animation-delay: 0.36s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise { animation: none; }
    .card, .card-arrow { transition: none; }
  }

  /* ─── narrow ────────────────────────────────────────────────── */
  @media (max-width: 820px) {
    .projects { grid-template-columns: 1fr; }
    .card { min-height: 0; }
  }

  @media (max-width: 640px) {
    .labs { padding: 2.5rem 1rem 2rem; }
    .card { padding: 1.25rem 1.2rem 1.1rem; gap: 1.1rem; }
    .int-soon { font-size: 0.82rem; letter-spacing: 0.26em; }
  }
</style>
