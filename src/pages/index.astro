<script>
  // ─── scroll reveal ───
  const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const reveal = (el: Element) => el.classList.add('revealed');

  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          reveal(entry.target);
          io.unobserve(entry.target);
        }
      }
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

    revealTargets.forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        reveal(el);
      } else {
        io.observe(el);
      }
    });
  } else {
    revealTargets.forEach(reveal);
  }

  // ─── mobile catalog scrubber ───
  const grid = document.querySelector<HTMLElement>('.catalog-grid');
  const dots = document.querySelectorAll<HTMLElement>('.catalog-dot');
  const hint = document.querySelector<HTMLElement>('.catalog-hint');

  if (grid && dots.length) {
    const groups = grid.querySelectorAll<HTMLElement>('.cat-group');

    const updateDots = () => {
      if (!groups.length) return;
      const gridRect = grid.getBoundingClientRect();
      const center = gridRect.left + gridRect.width / 2;
      let closest = 0;
      let minDist = Infinity;
      groups.forEach((g, i) => {
        const r = g.getBoundingClientRect();
        const gc = r.left + r.width / 2;
        const dist = Math.abs(gc - center);
        if (dist < minDist) { minDist = dist; closest = i; }
      });
      dots.forEach((d, i) => d.classList.toggle('active', i === closest));
    };

    let hintDismissed = false;
    grid.addEventListener('scroll', () => {
      updateDots();
      if (!hintDismissed && grid.scrollLeft > 20 && hint) {
        hint.classList.add('dismissed');
        hintDismissed = true;
      }
    }, { passive: true });

    updateDots();

    if (hint) {
      setTimeout(() => { if (!hintDismissed) hint.classList.add('dismissed'); }, 7000);
    }
  }
</script>
